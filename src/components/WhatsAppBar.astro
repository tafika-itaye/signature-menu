---
import site from "../data/site.json";

const { label = "Chat with our staff" } = Astro.props;
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<a class="wabar" href={href} target="_blank" rel="noopener" aria-label={`${label} on WhatsApp`}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3.5 4c-.2 0-.5 0-.7.4l-.5 1.1c-.2.6 0 1.4.4 2.1a9.3 9.3 0 0 0 4.3 4c1.2.5 2.1.6 2.8.4.5-.1 1.2-.6 1.4-1.2.1-.5.1-.9 0-1l-.4-.2-1.7-.8c-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1a7.2 7.2 0 0 1-3.4-3c-.1-.2 0-.4.1-.5l.5-.6c.2-.2.2-.3.3-.5V9l-.7-1.7c-.2-.4-.4-.4-.6-.4Z"
    ></path>
  </svg>
  <span>{label}</span>
</a>
