---
import site from "../data/site.json";

const { category } = Astro.props;
const base = import.meta.env.BASE_URL;
const money = (n) => `${site.currency} ${n.toLocaleString("en-US")}`;
---

<section class="course" id={category.id}>
  <header>
    <h2>{category.name}</h2>
    <span class="count">{category.items.length}</span>
  </header>
  {
    category.items.map((item) => (
      <article class="plate">
        <img src={`${base}img/${item.image}-sm.webp`} alt={item.name} width="240" height="240" loading="lazy" decoding="async" />
        <h3>{item.name}</h3>
        <span class="price">{money(item.price)}</span>
        {item.note && <p>{item.note}</p>}
      </article>
    ))
  }
</section>
