---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const base = import.meta.env.BASE_URL;
---

<Base title={`${site.fullName}, ${site.town}`}>
  <header class="masthead">
    <p class="eyebrow">{site.town}, {site.country}</p>
    <h1 class="display">{site.name}</h1>
    <p class="motto">{site.tagline}</p>
    <p class="sub">
      {site.blurb} Kitchen {site.hours.kitchen}, bar {site.hours.bar}. Order from your table on WhatsApp.
    </p>
  </header>

  <nav class="panels" aria-label="Sections">
    {
      site.sections.map((section) => (
        <a class="panel" href={`${base}${section.slug}/`}>
          <img src={`${base}img/${section.hero}.webp`} alt="" width="1200" height="900" loading="eager" decoding="async" />
          <span class="scrim"></span>
          <span class="lbl">
            <h2 class="display">{section.title}</h2>
            <p>{section.tagline}</p>
          </span>
          <span class="go">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </span>
        </a>
      ))
    }
  </nav>

  <section class="specials">
    <p class="eyebrow">At the venue</p>
    <p>{site.specialties.join(" · ")}</p>
  </section>

  <footer class="foot">
    <strong>{site.fullName}</strong>, formerly {site.formerName}. {site.town}, {site.country}.<br />
    WhatsApp {site.whatsappDisplay}. Prices in Malawi kwacha and include VAT.
  </footer>
</Base>
